{
  "name": "kindred-shelf",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @kindred/web dev",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.21.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
